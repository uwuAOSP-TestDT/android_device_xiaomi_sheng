on post-fs-data
    chown system system /sys/bus/platform/devices/soc:fingerprint_fpc/power_ctrl
    chmod 0660 /sys/bus/platform/devices/soc:fingerprint_fpc/power_ctrl

on property:persist.sys.sheng.pen_mode=*
    exec /vendor/bin/xiaomi-pen ${persist.sys.sheng.pen_mode}
